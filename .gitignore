# Secrets (sec. 7.2, 43.1, 58.5) -- never versioned
.env
.env.*
!.env.example

# Runtime state: databases, bars, logs, kill-switch file (sec. 53, 58.5)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
control/*
!control/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.log

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/
